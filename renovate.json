{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in the Dockerfile with a `# renovate:` comment",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ENV|ARG) \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Images pinned by tag and digest in workflow env vars with a `# renovate:` comment",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: [^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "The PHP versions are chosen by the workflow matrix, not bumped by Renovate",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "enabled": false
    },
    {
      "description": "GitHub release tags such as v2.103.2 map to the bare versions pinned in the Dockerfile",
      "matchDatasources": ["github-releases"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "One PR for all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Merge non-major updates once CI passes, since it builds and smoke-tests every image; major updates wait for review",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    }
  ]
}
